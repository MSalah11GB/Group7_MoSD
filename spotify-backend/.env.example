PORT=4000
MONGODB_URI=mongodb://localhost:27017

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Optional: Spotify metadata lookup used by the admin "fill from Spotify" button
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comma-separated origins allowed by CORS (user site, admin site)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Comma-separated Clerk user ids that are always admins.
# Users can also be made admins by setting publicMetadata { "role": "admin" } in Clerk.
ADMIN_USER_IDS=

# Max size of a playlist cover image uploaded through the API, in MB.
# (Admin uploads of songs and artwork go straight to Cloudinary and are limited by your Cloudinary plan.)
MAX_UPLOAD_MB=5
