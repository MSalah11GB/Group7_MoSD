  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@clerk/express": "^1.7.60",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "pino": "^10.3.1",
    "spotify-web-api-node": "^5.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
